{
  "name": "tongs-browser",
  "version": "0.25.59",
  "description": "Virtual mouse pointer, sticky modifier keys, and mobile UI scaling for Foundry VTT on Android",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Lewis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LewisIsWorking/Tongs-Browser.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "lint": "npm run lint:code && npm run lint:prose && npm run lint:docblocks && npm run format:check",
    "lint:code": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prose": "node scripts/check-em-dashes.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe:foundry": "node scripts/foundry-probe.ts",
    "check:foundry": "node scripts/foundry-live-check.ts",
    "check:touch": "node scripts/foundry-touch-check.ts",
    "check:multitouch": "node scripts/foundry-multitouch-check.ts",
    "check:android": "node scripts/foundry-android-check.ts",
    "check:drag": "node scripts/foundry-drag-check.ts",
    "probe:play": "node scripts/foundry-play-probe.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:support": "node scripts/check-support-adopted.ts",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:scripts && npm run check:scripts && npm run check:sizes && npm run check:readmes && npm run check:support && npm run test && npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:browser",
    "lint:docblocks": "node scripts/check-orphaned-docblocks.ts",
    "prune:imports": "node scripts/prune-unused-imports.ts",
    "check:scripts": "node scripts/check-scripts-load.ts",
    "check:sizes": "node scripts/check-file-sizes.ts --self-test && node scripts/check-file-sizes.ts",
    "check:readmes": "node scripts/check-folder-readmes.ts --self-test && node scripts/check-folder-readmes.ts",
    "check:grab": "node scripts/foundry-grab-button-check.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
